  "enabledMcpjsonServers": [
    "eslint",
    "docs-langchain"
  ],
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": ["docker:*", "docker-compose:*", "make:*"],
