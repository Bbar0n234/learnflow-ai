# Infrastructure (docker-compose)
POSTGRES_USER=learnflow
POSTGRES_PASSWORD=learnflow
POSTGRES_DB=learnflow
POSTGRES_PORT=5432

# Application
DATABASE_URL=postgresql+psycopg://learnflow:learnflow@db:5432/learnflow
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1

# Auth
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# Logging
LOG_LEVEL=info
LOG_FILE=

# Langfuse Observability
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=production
LANGFUSE_RELEASE= # SDK reads automatically; tags traces with release version (e.g. git hash)
LANGFUSE_PROMPT_LABEL=development  # Use "production" for production deployment
LANGFUSE_PROMPT_CACHE_TTL=60

# Security (prompt injection protection)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CANARY_SECRET=

# MCP Encryption (for storing user MCP server API keys)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCP_ENCRYPTION_KEY=

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# SIEM
SIEM_FRONTEND_ORIGIN=http://localhost:8000,http://localhost:5173

# MCP External Tools
FIRECRAWL_API_KEY=your-firecrawl-api-key-here
TAVILY_API_KEY=your-tavily-api-key-here
