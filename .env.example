# Infrastructure (docker-compose)
POSTGRES_USER=learnflow
POSTGRES_PASSWORD=learnflow
POSTGRES_DB=learnflow
POSTGRES_PORT=5432
# Host-side порты app/siem-service (сдвигай при параллельных стендах в worktree)
APP_PORT=8000
SIEM_PORT=8001

# Application
DATABASE_URL=postgresql+psycopg://learnflow:learnflow@db:5432/learnflow
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1

# Auth
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# Client IP — источник клиентского IP для rate-лимитов и логов (socket / x-real-ip / x-forwarded-for)
# Прод ставит x-real-ip (за nginx). CLIENT_IP_XFF_HOPS значим только при x-forwarded-for.
CLIENT_IP_SOURCE=socket
CLIENT_IP_XFF_HOPS=1

# CORS — разрешённые origins фронтенда (CSV, не JSON)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# OAuth providers — пусто → провайдер выключен. Реальные пары client_id/secret — в .env.local (gitignored).
OAUTH_YANDEX_CLIENT_ID=
OAUTH_YANDEX_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# База для redirect_uri (`{base}/api/auth/oauth/{provider}/callback`). Docker-топология: SPA отдаёт backend → :8000.
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
OAUTH_HTTP_TIMEOUT_SECONDS=10

# GeoIP (гео-gate) — RU получает только Яндекс + пароль, остальные страны — все активные провайдеры.
# Путь совпадает с mount'ом docker-compose (./data/geoip → /app/data/geoip) — положи файл
# базы в ./data/geoip/ipinfo_lite.mmdb. Отсутствующий файл → fallback на GEOIP_FALLBACK_COUNTRY
# (fail-closed в сторону закона), с явным warning'ом в логе.
GEOIP_DB_PATH=/app/data/geoip/ipinfo_lite.mmdb
GEOIP_FALLBACK_COUNTRY=RU

# Logging
LOG_LEVEL=info
LOG_FILE=

# Langfuse Observability
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=production
# SDK reads automatically; tags traces with release version (e.g. git hash)
LANGFUSE_RELEASE=
LANGFUSE_PROMPT_LABEL=development  # Use "production" for production deployment
LANGFUSE_PROMPT_CACHE_TTL=60

# Security (prompt injection protection)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CANARY_SECRET=

# LLM_DEFENSE_ENABLED — операционный тумблер inline LLM-защиты (детекторы + LLM-классификатор + security-часть промпта)
# Дефолт true (dev как сейчас), прод ставит false. Флаг читается один раз в lifespan — переключение требует рестарта контейнера.
LLM_DEFENSE_ENABLED=true

# MCP Encryption (for storing user MCP server API keys)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCP_ENCRYPTION_KEY=

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# Operational knobs — tune without rebuild (D-ERR-9)
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_SECONDS=120
LLM_GUARD_TIMEOUT_SECONDS=45
LLM_SUMMARIZER_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=2
LLM_IMAGE_TIMEOUT_SECONDS=120
LLM_TITLE_TIMEOUT_SECONDS=20
MCP_TIMEOUT_SECONDS=30

# ───────── Workspace (file layer, ADR-032) ─────────

# Two allowed roots for agent/REST path resolution. Defaults are the
# container mount points (see the `app` service volumes below);
# .env.local.example overrides both for host-mode dev (make dev), where
# /workspaces and /skills don't exist.
WORKSPACES_ROOT=/workspaces
SKILLS_ROOT=/skills
# read_file truncation limit (characters)
WORKSPACE_READ_LIMIT_CHARS=50000
# artifacts/ diff-snapshot before-copy limits (bytes): per file and total per job
WORKSPACE_DIFF_FILE_LIMIT_BYTES=1000000
WORKSPACE_DIFF_TOTAL_LIMIT_BYTES=10000000
# POST /uploads size ceiling (bytes)
UPLOAD_MAX_SIZE_BYTES=20000000

# ───────── Executor (execute_code / run_command, ADR-031) ─────────

# Client-side knobs of the httpx wrapper around the executor service.
# EXECUTOR_JOB_TIMEOUT_SECONDS must stay ≤ the executor's own
# EXECUTOR_MAX_TIMEOUT_SECONDS (300, services/executor default) — otherwise
# the executor silently clamps it. EXECUTOR_CLIENT_TIMEOUT_GRACE_SECONDS
# must stay ≥ the executor's EXECUTOR_KILL_GRACE_SECONDS (5s) plus slack, so
# the client doesn't give up before the executor's own kill contract resolves.
EXECUTOR_BASE_URL=http://executor:8002
# Shared secret между backend'ом и executor'ом: backend шлёт его в
# `Authorization: Bearer` на каждый POST /jobs, executor без него отвечает
# 401. Одна переменная — оба сервиса (docker-compose.yml пробрасывает её и в
# `app`, и в `executor`), значения обязаны совпадать. Обязателен: ни один из
# двух сервисов без него не стартует (§ Секреты и fail-fast) — иначе доступ к
# произвольному выполнению кода держался бы только на сетевом сегменте.
EXECUTOR_AUTH_TOKEN=change-me-to-a-random-string-at-least-32-chars
EXECUTOR_JOB_TIMEOUT_SECONDS=60
EXECUTOR_CLIENT_TIMEOUT_GRACE_SECONDS=10

# ───────── Executor service (services/executor container, ADR-031) ─────────

# Operational knobs of the executor container itself (not the httpx client
# above) — services/executor/executor/config.py, same EXECUTOR_ prefix.
# Contract: tracks/T3/plan.md § EXECUTOR_-knobs. EXECUTOR_SANDBOX_ENABLED
# (dev-only bwrap kill-switch) is deliberately not listed here and not set
# in docker-compose.yml — its default (true) must hold in every deployed
# environment (T3 Open Question 2). EXECUTOR_AUTH_TOKEN — общий секрет обоих
# сервисов, объявлен выше в клиентском блоке, второй раз не дублируется.
EXECUTOR_WORKSPACES_ROOT=/workspaces
EXECUTOR_SKILLS_ROOT=/skills
EXECUTOR_DEFAULT_TIMEOUT_SECONDS=60
# Ceiling that request timeouts get clamped to. docker-compose.yml's
# executor.stop_grace_period must stay >= this value + EXECUTOR_KILL_GRACE_SECONDS.
EXECUTOR_MAX_TIMEOUT_SECONDS=300
# Per-stream (stdout/stderr) output ceiling, bytes.
EXECUTOR_MAX_OUTPUT_BYTES=262144
EXECUTOR_KILL_GRACE_SECONDS=5
EXECUTOR_LOG_LEVEL=info

# EXECUTOR_RUNTIME — compose-level container runtime for the executor service
# (docker-compose.yml `runtime:` interpolation, NOT an app/executor Settings
# knob — never read via os.environ by application code). Default runsc is the
# prod isolation boundary (ADR-031) and must not weaken silently. Dev hosts
# without gVisor registered in the docker daemon override to runc in their
# own .env (see .env.local.example) — never change the default here.
EXECUTOR_RUNTIME=runsc

# EXECUTOR_MEM_LIMIT — compose-level memory ceiling of the executor container
# (docker-compose.yml `mem_limit:` interpolation, same nature as
# EXECUTOR_RUNTIME above — not a Settings knob). Sized against the host, not
# the product: on a VM that also runs other services, the default takes half
# the RAM and one heavy job drags its neighbours into the OOM killer. Lower it
# per host (`1g` on a 4 GB VM); a job hitting the ceiling dies alone.
EXECUTOR_MEM_LIMIT=2g

# ───────── SIEM service ─────────

# SIEM_ENABLED — операционный тумблер эмиссии security-событий в Redis Stream
# Дефолт true (dev как сейчас), прод ставит false. Флаг читается один раз в lifespan — переключение требует рестарта контейнера.
# Выключает только эмиссию — контейнеры гасит COMPOSE_PROFILES, UI — VITE_SIEM_ENABLED.
SIEM_ENABLED=true

# COMPOSE_PROFILES — штатная переменная docker compose (не настройка приложения), а не SIEM_*: включает контейнеры
# siem-service и siem-db. Dev: siem (как сейчас). Прод оставляет пустой — compose не поднимет и не соберёт SIEM.
# Не комментировать: на этой строке держится сборочная проверка siem-Dockerfile в CI (cp .env.example .env && docker compose build).
COMPOSE_PROFILES=siem

# Database (siem-db container, separate logical DB)
SIEM_POSTGRES_USER=siem
SIEM_POSTGRES_PASSWORD=siem
SIEM_POSTGRES_DB=siem
# Host-side port for siem-db (avoids 5432 clash with main `db`).
# Used by `make migrate-siem` and ad-hoc psql from the host.
SIEM_POSTGRES_PORT=5434
# Database URL used by alembic when running `make migrate-siem` from the host
# (Settings.database_url default points at localhost — override here so it
# matches the published port above).
SIEM_DATABASE_URL=postgresql+asyncpg://siem:siem@localhost:5434/siem

# CORS — Frontend origin(s) for siem-service (port 8001)
# Docker dev: bundled frontend (8000) + Vite (5173)
SIEM_FRONTEND_ORIGIN=http://localhost:8000,http://localhost:5173

# Event processing (operational knobs, tune without rebuild)
SIEM_XREAD_BATCH_SIZE=100
SIEM_XREAD_BLOCK_MS=1000
SIEM_POLL_INTERVAL_SECONDS=10

# Retention (days)
SIEM_DELETE_AFTER_DAYS=90

# Correlation: max age (s) of an open alert before a fresh one is created
SIEM_ALERT_OPEN_WINDOW_SECONDS=86400

# Event pipeline: PEL delivery attempts before terminal drop (D-ERR-7)
SIEM_MAX_DELIVERY_ATTEMPTS=5

# SIEM operational knobs — tune without rebuild (D-ERR-9)
# Invariant: SIEM_REDIS_SOCKET_TIMEOUT > SIEM_XREAD_BLOCK_MS / 1000 (OQ-D)
SIEM_REDIS_SOCKET_TIMEOUT=5
SIEM_REDIS_SOCKET_CONNECT_TIMEOUT=5
SIEM_DB_STATEMENT_TIMEOUT_SECONDS=120

# MCP External Tools
JINA_API_KEY=your-jina-api-key-here
FIRECRAWL_API_KEY=your-firecrawl-api-key-here

# ───────── Frontend (Vite) ─────────
# Operational knobs — документируются здесь (OQ-F: единый .env.example, без frontend/.env.example).
# Vite подхватывает эти переменные из окружения сборки; инлайн-fallback в коде используется если не задано.

# API URL (main backend)
VITE_API_URL=http://localhost:8000/api
# SIEM API URL
VITE_SIEM_API_URL=http://localhost:8001/api
# SIEM UI kill-switch (роут /security, кнопка «Безопасность»). В docker-сборке значение
# приходит из SIEM_ENABLED через build.args — эта строка описывает путь без docker
# (make dev-fe, локальный npm run build). Менять UI-флаг для прода — через SIEM_ENABLED,
# не здесь.
VITE_SIEM_ENABLED=true
# Axios timeout для REST-запросов (мс) — apiClient и siemClient
VITE_API_TIMEOUT_MS=30000
