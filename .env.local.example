# Local dev overrides (loaded after .env, values here win)
# Adjust port if your 5432 is occupied
DATABASE_URL=postgresql+psycopg://learnflow:learnflow@localhost:5432/learnflow

# Auth
SECURE_COOKIES=false

# Client IP — дефолт socket совпадает с системным для local dev, переопределение не требуется
# CLIENT_IP_SOURCE=socket
# CLIENT_IP_XFF_HOPS=1 — значим только при CLIENT_IP_SOURCE=x-forwarded-for

# LLM_DEFENSE_ENABLED — дефолт true совпадает с системным, переопределение для local dev не требуется
# LLM_DEFENSE_ENABLED=true

# Redis
REDIS_URL=redis://localhost:6379/0

# Workspace (file layer) — /workspaces and /skills are container mount
# points and don't exist in host-mode dev; point at repo-root-relative dirs
# instead (WORKSPACES_ROOT is gitignored, SKILLS_ROOT is the tracked skills/
# directory). The executor container isn't part of `make dev`'s topology, so
# execute_code/run_command are unavailable in this mode regardless of any
# EXECUTOR_* override. EXECUTOR_AUTH_TOKEN всё равно обязателен и в этом
# режиме — backend не стартует без него; значение берётся из `.env` (базовый
# файл грузится первым), переопределять здесь нечего.
WORKSPACES_ROOT=./workspaces
SKILLS_ROOT=./skills

# EXECUTOR_RUNTIME — dev hosts without gVisor (`runsc`) registered in the
# docker daemon need `EXECUTOR_RUNTIME=runc` to bring up the executor
# service. Set it in your own `.env` (not here): docker compose reads `.env`
# only, not `.env.local` — this line here would silently never take effect.
# EXECUTOR_RUNTIME=runc
# EXECUTOR_MEM_LIMIT — та же природа (compose-level, читается только из `.env`):
# потолок памяти контейнера executor, подбирается под машину. На dev-хосте
# дефолт 2g обычно и нужен.

# SIEM (local dev — only the values that differ from .env)
# SIEM_ENABLED — дефолт true совпадает с системным, переопределение для local dev не требуется
# SIEM_ENABLED=true
# COMPOSE_PROFILES задаётся только в .env — docker compose не читает этот файл, переопределение здесь не сработает.
# Used when siem-service is run directly via `uv run uvicorn`, not in Docker
SIEM_DATABASE_URL=postgresql+asyncpg://siem:siem@localhost:5434/siem
SIEM_REDIS_URL=redis://localhost:6379
SIEM_FRONTEND_ORIGIN=http://localhost:8000,http://localhost:5173
# Обязателен (siem-service не стартует без него); держи в синхроне с JWT_SECRET
SIEM_JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
# Event pipeline: PEL delivery attempts before terminal drop (D-ERR-7)
SIEM_MAX_DELIVERY_ATTEMPTS=5

# Logging
LOG_LEVEL=info

# Langfuse prompts
LANGFUSE_PROMPT_LABEL=development
