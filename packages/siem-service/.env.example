# SIEM Service Configuration

# Database
SIEM_DATABASE_URL=postgresql+asyncpg://siem:siem@localhost/siem

# Redis
SIEM_REDIS_URL=redis://localhost:6379

# Security (must match main app's JWT_SECRET)
SIEM_JWT_SECRET=change-me-in-production

# CORS — Frontend origin(s)
# Leave empty (default) for local Vite development (allows http://localhost:5173)
# Docker development should also allow the bundled frontend at http://localhost:8000
# For production: set to comma-separated list of allowed origins
# Example: SIEM_FRONTEND_ORIGIN=https://app.example.com,https://admin.example.com
SIEM_FRONTEND_ORIGIN=http://localhost:8000,http://localhost:5173

# Event processing
SIEM_XREAD_BATCH_SIZE=100
SIEM_XREAD_BLOCK_MS=1000
SIEM_POLL_INTERVAL_SECONDS=10

# Retention
SIEM_DELETE_AFTER_DAYS=90
