# LearnFlowAI red team scan — provider configuration.
# Copy to .env and fill in values. .env is gitignored.

# Backend base URL for the running LearnFlowAI instance.
LEARNFLOW_BASE_URL=http://localhost:8000

# Dedicated eval user. Provider will register on first run if user does not exist.
# Use a unique name; do NOT reuse a real user.
LEARNFLOW_SCAN_USERNAME=promptfoo-eval

# Password for the eval user (min 8 chars). Set locally; never commit.
LEARNFLOW_SCAN_PASSWORD=

# Optional run identifier. Default: ISO timestamp. Used to group reports/<run-id>/.
LEARNFLOW_SCAN_RUN_ID=

# Optional report directory. Default: reports/<run-id>/ relative to provider file.
LEARNFLOW_SCAN_REPORT_DIR=

# HTTP/SSE timeout in seconds.
LEARNFLOW_SCAN_TIMEOUT_SECONDS=120

# When true, provider truncates prompt/output in event log for sensitive runs.
# Baseline learning runs use false to keep audit evidence rich.
LEARNFLOW_SCAN_SANITIZE_LOGS=false
